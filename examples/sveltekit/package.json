{
  "name": "color-foundry-sveltekit-starter",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tokens": "node ./scripts/generate.mjs",
    "dev": "vite dev",
    "build": "npm run tokens && vite build",
    "check": "npm run tokens && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "preview": "vite preview",
    "predev": "npm run tokens",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright test --reporter=list"
  },
  "dependencies": {
    "color-foundry-engine": "file:../.."
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.0",
    "@playwright/test": "^1.56.0",
    "@axe-core/playwright": "^4.10.0"
  }
}
